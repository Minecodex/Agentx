{
  "$defs": {
    "ReplayPolicyV1": {
      "enum": [
        "safe",
        "never",
        "idempotency_required",
        "ledger_dependent"
      ],
      "type": "string"
    },
    "ResourceReferenceV1": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "type": "string"
        },
        "resourceId": {
          "type": "string"
        },
        "resourceType": {
          "type": "string"
        },
        "resourceVersionId": {
          "type": "string"
        }
      },
      "required": [
        "resourceType",
        "resourceId",
        "resourceVersionId",
        "operation"
      ],
      "type": "object"
    },
    "ToolDefinitionV1": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "inputSchema": true,
        "name": {
          "type": "string"
        },
        "origin": {
          "$ref": "#/$defs/ToolOriginV1"
        },
        "replayPolicy": {
          "$ref": "#/$defs/ReplayPolicyV1"
        }
      },
      "required": [
        "name",
        "description",
        "inputSchema",
        "origin",
        "replayPolicy"
      ],
      "type": "object"
    },
    "ToolOriginV1": {
      "enum": [
        "core",
        "platform",
        "mcp",
        "skill",
        "knowledge",
        "memory"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attachments": {
      "items": {
        "$ref": "#/$defs/ResourceReferenceV1"
      },
      "type": "array"
    },
    "bundleVersion": {
      "type": "string"
    },
    "coreContractVersion": {
      "type": "string"
    },
    "coreTools": {
      "items": {
        "$ref": "#/$defs/ToolDefinitionV1"
      },
      "type": "array"
    },
    "model": {
      "$ref": "#/$defs/ResourceReferenceV1"
    },
    "referenceCommit": {
      "type": "string"
    },
    "workspaceSandbox": {
      "anyOf": [
        {
          "$ref": "#/$defs/ResourceReferenceV1"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "bundleVersion",
    "coreContractVersion",
    "referenceCommit",
    "model",
    "coreTools",
    "attachments"
  ],
  "title": "AgentBundleV2",
  "type": "object"
}
