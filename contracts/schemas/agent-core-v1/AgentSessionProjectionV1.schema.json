{
  "$defs": {
    "ApplicationUserEvidenceV1": {
      "additionalProperties": false,
      "properties": {
        "evidenceHash": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "userIdentityId": {
          "type": "string"
        }
      },
      "required": [
        "userIdentityId",
        "source",
        "evidenceHash"
      ],
      "type": "object"
    },
    "RetentionPolicyV1": {
      "additionalProperties": false,
      "properties": {
        "compactionArtifactExpiresAtMillis": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "protectReferencedArtifacts": {
          "default": false,
          "type": "boolean"
        },
        "sessionExpiresAtMillis": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "SessionPolicyModeV1": {
      "enum": [
        "application_session",
        "invocation"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Projection of the durable Register supplied to one Core invocation.  The\nWorker remains authoritative for loading and CAS; Core treats this as an\nimmutable recovery hint and never derives identity from user input.",
  "properties": {
    "leafEntryId": {
      "type": [
        "string",
        "null"
      ]
    },
    "mode": {
      "$ref": "#/$defs/SessionPolicyModeV1"
    },
    "openOperationId": {
      "type": [
        "string",
        "null"
      ]
    },
    "retention": {
      "$ref": "#/$defs/RetentionPolicyV1",
      "default": {
        "protectReferencedArtifacts": false
      }
    },
    "sessionKey": {
      "type": "string"
    },
    "stateVersion": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "trustedSubject": {
      "anyOf": [
        {
          "$ref": "#/$defs/ApplicationUserEvidenceV1"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "mode",
    "sessionKey",
    "stateVersion"
  ],
  "title": "AgentSessionProjectionV1",
  "type": "object"
}
