{
  "$defs": {
    "TraceContentKindV1": {
      "enum": [
        "workflow_input",
        "workflow_output",
        "node_input",
        "node_output",
        "attempt_input",
        "attempt_output",
        "resolved_parameters",
        "runtime_request",
        "runtime_response",
        "agent_input",
        "agent_output",
        "iteration_input",
        "iteration_output",
        "sandbox_request",
        "sandbox_response",
        "wait_request",
        "wait_response",
        "conversion_record",
        "plugin_content"
      ],
      "type": "string"
    },
    "TraceEventEnvelopeV1": {
      "additionalProperties": false,
      "properties": {
        "agentIterationId": {
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
        },
        "agentRunId": {
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
        },
        "applicationId": {
          "default": null,
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
        },
        "attemptId": {
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
        },
        "attributes": true,
        "contentHash": {
          "type": "string"
        },
        "contentKind": {
          "anyOf": [
            {
              "$ref": "#/$defs/TraceContentKindV1"
            },
            {
              "type": "null"
            }
          ]
        },
        "contentPreview": true,
        "contentRef": {
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
        },
        "costMicros": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "durationMs": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "errorCode": {
          "type": [
            "string",
            "null"
          ]
        },
        "errorMessage": {
          "type": [
            "string",
            "null"
          ]
        },
        "eventId": {
          "format": "uuid",
          "type": "string"
        },
        "eventKind": {
          "$ref": "#/$defs/TraceEventKindV1"
        },
        "eventType": {
          "type": "string"
        },
        "executionId": {
          "format": "uuid",
          "type": "string"
        },
        "executionSequence": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "inputTokens": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "nodeExecutionId": {
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
        },
        "occurredAt": {
          "type": "string"
        },
        "outputTokens": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "parentSpanId": {
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
        },
        "resourceId": {
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
        },
        "resourceType": {
          "type": [
            "string",
            "null"
          ]
        },
        "resourceVersion": {
          "type": [
            "string",
            "null"
          ]
        },
        "runtimeCallId": {
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
        },
        "sandboxLeaseId": {
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
        },
        "schemaVersion": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "spanId": {
          "format": "uuid",
          "type": "string"
        },
        "spanKind": {
          "$ref": "#/$defs/TraceSpanKindV1"
        },
        "spanName": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "tenantId": {
          "format": "uuid",
          "type": "string"
        },
        "traceId": {
          "format": "uuid",
          "type": "string"
        },
        "waitId": {
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
        },
        "workflowId": {
          "default": null,
          "description": "Aggregation dimensions (plan7 P7-C): filled at the single outbox\nenqueue point from the execution row; absent on events produced by\nolder runtimes (serde default keeps the consumer green during the\nrollout window).",
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "schemaVersion",
        "eventId",
        "tenantId",
        "executionId",
        "executionSequence",
        "traceId",
        "spanId",
        "eventKind",
        "spanKind",
        "spanName",
        "eventType",
        "status",
        "costMicros",
        "attributes",
        "occurredAt",
        "contentHash"
      ],
      "type": "object"
    },
    "TraceEventKindV1": {
      "enum": [
        "started",
        "updated",
        "finished"
      ],
      "type": "string"
    },
    "TraceSpanKindV1": {
      "enum": [
        "execution",
        "boundary",
        "node",
        "attempt",
        "agent_run",
        "agent_iteration",
        "runtime_call",
        "sandbox",
        "wait",
        "plugin_operation"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "degraded": {
      "type": "boolean"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/TraceEventEnvelopeV1"
      },
      "type": "array"
    },
    "next": {
      "type": [
        "string",
        "null"
      ]
    },
    "queryId": {
      "format": "uuid",
      "type": "string"
    }
  },
  "required": [
    "apiVersion",
    "queryId",
    "events",
    "degraded"
  ],
  "title": "TraceSearchPageV1",
  "type": "object"
}
