{
  "$defs": {
    "ExecutionCommandV1": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "content": true,
            "executionId": {
              "format": "uuid",
              "type": "string"
            },
            "kind": {
              "const": "submit_input",
              "type": "string"
            },
            "waitId": {
              "format": "uuid",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "executionId",
            "waitId",
            "content"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "executionId": {
              "format": "uuid",
              "type": "string"
            },
            "expectedStateVersion": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "cancel",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "executionId",
            "expectedStateVersion"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "checkpointId": {
              "format": "uuid",
              "type": "string"
            },
            "kind": {
              "const": "fork",
              "type": "string"
            },
            "mode": {
              "$ref": "#/$defs/PartialExecutionModeV1"
            },
            "nodeId": {
              "type": [
                "string",
                "null"
              ]
            },
            "origin": {
              "$ref": "#/$defs/ExecutionOriginV1"
            },
            "sideEffectResolution": {
              "$ref": "#/$defs/SideEffectResolutionV1"
            },
            "sourceExecutionId": {
              "format": "uuid",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "sourceExecutionId",
            "checkpointId",
            "origin",
            "mode",
            "sideEffectResolution"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "executionId": {
              "format": "uuid",
              "type": "string"
            },
            "expectedStateVersion": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "side_effect_confirmation",
              "type": "string"
            },
            "nodeExecutionId": {
              "format": "uuid",
              "type": "string"
            },
            "resolution": {
              "$ref": "#/$defs/SideEffectResolutionV1"
            }
          },
          "required": [
            "kind",
            "executionId",
            "nodeExecutionId",
            "resolution",
            "expectedStateVersion"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "expectedVersion": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "work_package_cancel",
              "type": "string"
            },
            "packageId": {
              "format": "uuid",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "packageId",
            "expectedVersion"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "dryRun": {
              "type": "boolean"
            },
            "kind": {
              "const": "retention_run",
              "type": "string"
            },
            "policyVersion": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "runId": {
              "format": "uuid",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "runId",
            "dryRun",
            "policyVersion"
          ],
          "type": "object"
        }
      ]
    },
    "ExecutionDepartmentSnapshotV1": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "type": "object"
    },
    "ExecutionOriginV1": {
      "additionalProperties": false,
      "description": "Immutable audit context captured when an Execution is created.\n\nControl remains authoritative for current IAM and resource names. Runtime\nstores this snapshot so later renames do not rewrite execution history.",
      "properties": {
        "initiatorDepartmentId": {
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
        },
        "initiatorDepartmentName": {
          "type": [
            "string",
            "null"
          ]
        },
        "initiatorUserId": {
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
        },
        "initiatorUserName": {
          "type": [
            "string",
            "null"
          ]
        },
        "roleAssignments": {
          "items": {
            "$ref": "#/$defs/ExecutionRoleAssignmentV1"
          },
          "type": "array"
        },
        "triggerName": {
          "type": [
            "string",
            "null"
          ]
        },
        "triggerSourceId": {
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "roleAssignments"
      ],
      "type": "object"
    },
    "ExecutionRoleAssignmentV1": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string"
        },
        "dataScope": {
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "scopeDepartment": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExecutionDepartmentSnapshotV1"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "code",
        "name",
        "dataScope"
      ],
      "type": "object"
    },
    "PartialExecutionModeV1": {
      "enum": [
        "whole",
        "node",
        "to_node",
        "from_node"
      ],
      "type": "string"
    },
    "SideEffectResolutionV1": {
      "enum": [
        "execute",
        "reuse_output",
        "dry_run"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "command": {
      "$ref": "#/$defs/ExecutionCommandV1"
    },
    "commandId": {
      "format": "uuid",
      "type": "string"
    },
    "idempotencyKey": {
      "type": "string"
    },
    "objectVersion": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "tenantId": {
      "format": "uuid",
      "type": "string"
    }
  },
  "required": [
    "apiVersion",
    "tenantId",
    "commandId",
    "objectVersion",
    "idempotencyKey",
    "command"
  ],
  "title": "RuntimeCommandApplyRequestV1",
  "type": "object"
}
