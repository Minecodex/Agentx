{
  "$defs": {
    "RuntimeTriggerConfigurationV1": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "fixedInputs": {
              "default": {}
            },
            "inputMappings": {
              "default": [],
              "items": {
                "$ref": "#/$defs/WebhookInputMappingV1"
              },
              "type": "array"
            },
            "kind": {
              "const": "webhook",
              "type": "string"
            },
            "mode": {
              "$ref": "#/$defs/WebhookChannelModeV1",
              "default": "callback"
            },
            "provider": {
              "$ref": "#/$defs/WebhookProviderV1",
              "default": "agentx"
            },
            "publicId": {
              "type": "string"
            },
            "reply": {
              "anyOf": [
                {
                  "$ref": "#/$defs/WebhookReplyConfigV1"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "secret": {
              "$ref": "#/$defs/VaultSecretReferenceV1"
            }
          },
          "required": [
            "kind",
            "publicId",
            "secret"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "cronExpression": {
              "type": "string"
            },
            "graceSeconds": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "input": true,
            "kind": {
              "const": "schedule",
              "type": "string"
            },
            "misfirePolicy": {
              "$ref": "#/$defs/ScheduleMisfirePolicyV1"
            },
            "timezone": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "cronExpression",
            "timezone",
            "misfirePolicy",
            "graceSeconds",
            "input"
          ],
          "type": "object"
        }
      ]
    },
    "ScheduleMisfirePolicyV1": {
      "enum": [
        "skip",
        "fire_once"
      ],
      "type": "string"
    },
    "VaultSecretReferenceV1": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string"
        },
        "mount": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "version": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "mount",
        "path",
        "key",
        "version"
      ],
      "type": "object"
    },
    "WebhookChannelModeV1": {
      "enum": [
        "callback",
        "stream"
      ],
      "type": "string"
    },
    "WebhookInputMappingV1": {
      "additionalProperties": false,
      "properties": {
        "missingPolicy": {
          "default": "error",
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "target": {
          "type": "string"
        }
      },
      "required": [
        "source",
        "target"
      ],
      "type": "object"
    },
    "WebhookProviderV1": {
      "enum": [
        "agentx",
        "dingtalk",
        "wecom",
        "feishu"
      ],
      "type": "string"
    },
    "WebhookReplyConfigV1": {
      "additionalProperties": false,
      "description": "Channel auto-reply configuration (plan7 P7-A L1): frozen into the trigger\nrevision alongside the rest of the channel configuration; the runtime\ndelivery loop enqueues an outbound reply when the execution reaches a\nterminal state.",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "outputField": {
          "description": "Name of the workflow output field whose value is replied (required\nwhen enabled; Control validates it against the deployment output\nschema before freezing).",
          "type": "string"
        },
        "template": {
          "default": null,
          "description": "Optional template over the output; only output-field variables are\nallowed. When empty the raw output field value is replied as text.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "enabled",
        "outputField"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "applicationId": {
      "format": "uuid",
      "type": "string"
    },
    "configuration": {
      "$ref": "#/$defs/RuntimeTriggerConfigurationV1"
    },
    "configurationHash": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean"
    },
    "nodeId": {
      "type": "string"
    },
    "revision": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "schemaVersion": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "triggerId": {
      "format": "uuid",
      "type": "string"
    },
    "triggerName": {
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "triggerId",
    "triggerName",
    "applicationId",
    "nodeId",
    "revision",
    "configurationHash",
    "enabled",
    "configuration"
  ],
  "title": "RuntimeTriggerSpecV1",
  "type": "object"
}
