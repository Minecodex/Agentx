          "type": "string"
        },
        "versionId": {
          "type": "string"
        }
      },
      "required": [
        "versionId",
        "currency",
        "inputPerMillion",
        "outputPerMillion"
      ],
      "type": "object"
    },
    "RuntimeResourceBindingV1": {
      "additionalProperties": false,
      "properties": {
        "configuration": {
          "$ref": "#/$defs/RuntimeResourceConfigurationV1"
        },
        "contentHash": {
          "type": "string"
        },
        "objectIds": {
          "items": {
            "format": "uuid",
            "type": "string"
