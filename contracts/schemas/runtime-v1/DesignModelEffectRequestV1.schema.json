    "ModelContentPartV1": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "string"
            },
            "type": {
              "const": "text",
              "type": "string"
            }
          },
          "required": [
            "type",
            "text"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "image_url": {
              "$ref": "#/$defs/ImageUrlV1"
            },
            "type": {
              "const": "image_url",
              "type": "string"
            }
          },
          "required": [
            "type",
            "image_url"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "input_audio": {
              "$ref": "#/$defs/InputAudioV1"
            },
            "type": {
              "const": "input_audio",
