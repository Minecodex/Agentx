    "AgentMessageV1": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "$ref": "#/$defs/ModelContentV1",
          "description": "Multimodal content (plan7 P7-B): plain text stays a bare JSON string\n(untagged, Text first) so existing session state deserializes without\nmigration; image/audio parts use the array form."
        },
        "isError": {
          "default": false,
          "type": "boolean"
        },
        "messageId": {
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/MessageRole"
        },
        "toolCallId": {
          "type": [
            "string",
            "null"
          ]
        },
        "toolCalls": {
          "items": {
            "$ref": "#/$defs/ToolCallV1"
          },
          "type": "array"
        }
      },
      "required": [
        "messageId",
        "role",
        "content"
      ],
      "type": "object"
    },
    "EffectContextV1": {
      "additionalProperties": false,
      "properties": {
        "deadlineAtMillis": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "effectId": {
          "type": "string"
        },
        "fencingToken": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "idempotencyKey": {
          "type": "string"
        },
        "operationId": {
          "type": "string"
        },
        "runId": {
          "type": "string"
        }
      },
      "required": [
        "runId",
        "operationId",
        "effectId",
        "idempotencyKey",
        "fencingToken",
        "deadlineAtMillis"
      ],
      "type": "object"
    },
    "ExecutionDepartmentSnapshotV1": {
      "additionalProperties": false,
