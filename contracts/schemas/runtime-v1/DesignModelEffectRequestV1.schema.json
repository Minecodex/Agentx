    "ModelContentV1": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "items": {
            "$ref": "#/$defs/ModelContentPartV1"
          },
          "type": "array"
        }
      ],
      "description": "One multimodal content part of a model message (plan7 P7-B). `Text` is\nthe untagged default so pure-text state and requests stay plain strings."
    },
    "ModelPurposeV1": {
      "enum": [
        "agent_turn",
        "compaction"
      ],
      "type": "string"
    },
    "ModelRequestV1": {
      "additionalProperties": false,
      "properties": {
        "messages": {
          "items": {
            "$ref": "#/$defs/AgentMessageV1"
          },
          "type": "array"
        },
        "modelReference": {
          "type": "string"
        },
        "purpose": {
          "$ref": "#/$defs/ModelPurposeV1"
        },
        "tools": {
          "items": {
            "$ref": "#/$defs/ToolDefinitionV1"
          },
          "type": "array"
        }
      },
      "required": [
        "purpose",
        "modelReference",
        "messages",
        "tools"
      ],
      "type": "object"
    },
    "ReplayPolicyV1": {
      "enum": [
        "safe",
        "never",
        "idempotency_required",
        "ledger_dependent"
      ],
      "type": "string"
    },
    "RuntimeEnvironmentCredentialReferenceV1": {
      "additionalProperties": false,
      "properties": {
        "credential": {
          "$ref": "#/$defs/VaultSecretReferenceV1"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
