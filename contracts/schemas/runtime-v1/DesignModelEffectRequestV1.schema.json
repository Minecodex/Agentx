        "versionNumber": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "name",
        "source"
      ],
      "type": "object"
    },
    "ImageUrlV1": {
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string"
        }
      },
      "required": [
        "url"
      ],
      "type": "object"
    },
    "InputAudioV1": {
      "additionalProperties": false,
