{
  "apiVersion": "agentx.io/claim-lease-audit/v1",
  "defaults": { "leaseSeconds": 30, "heartbeatSeconds": 10, "maxBatchSize": 100, "clock": "UTC_TIMESTAMP(6)" },
  "entries": [
    { "role": "control.publisher", "authority": "control_mysql.publish_attempts", "coordination": "mysql_skip_locked", "source": "src/services/platform-control/src/main.rs", "index": "idx_v206_publish_attempt_claim", "batchSize": 100, "externalIoAfterCommit": true, "recovery": "publish_attempt.next_action + idempotency receipt" },
    { "role": "control.admission_outbox", "authority": "control_mysql.outbox", "coordination": "mysql_skip_locked", "source": "src/services/platform-control/src/main.rs", "index": "idx_v206_control_outbox_claim", "batchSize": 100, "externalIoAfterCommit": true, "recovery": "outbox status + Runtime apply receipt" },
    { "role": "control.projector", "authority": "control_mysql.runtime_projection_cursors", "coordination": "mysql_partition_lease", "source": "src/services/platform-control/src/projector.rs", "index": "idx_v206_projection_lease", "batchSize": 100, "externalIoAfterCommit": true, "recovery": "cursor + projection_receipts + generation" },
    { "role": "control.retention", "authority": "control_mysql.retention_runs", "coordination": "mysql_skip_locked", "source": "src/services/platform-control/src/retention.rs", "index": "idx_v206_control_retention_claim", "batchSize": 1, "externalIoAfterCommit": true, "recovery": "retention command receipt" },
    { "role": "runtime.command", "authority": "runtime_mysql.runtime_commands", "coordination": "mysql_skip_locked", "source": "src/services/agentx-v2-runtime/src/execution.rs", "index": "idx_v206_runtime_command_claim", "batchSize": 100, "externalIoAfterCommit": true, "recovery": "command result + idempotency key" },
    { "role": "runtime.execution_outbox", "authority": "runtime_mysql.execution_outbox", "coordination": "mysql_skip_locked", "source": "src/services/agentx-v2-runtime/src/execution.rs", "index": "idx_v206_execution_outbox_claim", "batchSize": 100, "externalIoAfterCommit": true, "recovery": "execution_outbox + node_attempt state" },
    { "role": "runtime.event_sequencer", "authority": "runtime_mysql.integration_event_sequence", "coordination": "mysql_serialized_row", "source": "src/services/agentx-v2-runtime/src/event_export.rs", "index": "PRIMARY", "batchSize": 1, "externalIoAfterCommit": true, "recovery": "source_outbox_id uniqueness + global cursor" },
    { "role": "runtime.trigger", "authority": "runtime_mysql.trigger_bindings", "coordination": "mysql_skip_locked", "source": "src/services/agentx-v2-runtime/src/trigger.rs", "index": "idx_v206_trigger_claim", "batchSize": 100, "externalIoAfterCommit": true, "recovery": "binding cursor + deterministic invocation key" },
    { "role": "runtime.recovery", "authority": "runtime_mysql.execution_outbox", "coordination": "mysql_skip_locked_reconcile", "source": "src/services/agentx-v2-runtime/src/execution.rs", "index": "idx_execution_outbox_recovery", "batchSize": 100, "externalIoAfterCommit": true, "recovery": "indexed ID candidates + primary-key queued attempt/outbox recheck" },
    { "role": "runtime.artifact", "authority": "runtime_mysql.checkpoints", "coordination": "stable_object_key_cas", "source": "src/services/agentx-v2-runtime/src/artifact.rs", "index": "idx_checkpoint_externalize", "batchSize": 1, "externalIoAfterCommit": true, "recovery": "content hash + stable object id + row CAS" },
    { "role": "runtime.quota_leader", "authority": "runtime_mysql.runtime_role_leases", "coordination": "mysql_leader_lease", "source": "src/services/agentx-v2-runtime/src/quota.rs", "index": "PRIMARY", "batchSize": 1, "externalIoAfterCommit": true, "recovery": "MySQL reservation ledger rebuild" },
    { "role": "runtime.bundle_gc", "authority": "runtime_mysql.bundle_gc_items", "coordination": "mysql_skip_locked", "source": "src/services/agentx-v2-runtime/src/gc.rs", "index": "idx_v206_bundle_gc_item_claim", "batchSize": 100, "externalIoAfterCommit": true, "recovery": "GC item manifest + object status" },
    { "role": "runtime.retention", "authority": "runtime_mysql.retention_runs_items", "coordination": "mysql_skip_locked", "source": "src/services/agentx-v2-runtime/src/retention.rs", "index": "idx_v206_runtime_retention_item_claim", "batchSize": 100, "externalIoAfterCommit": true, "recovery": "retention item audit manifest" },
    { "role": "runtime.trace_relay", "authority": "runtime_mysql.trace_outbox", "coordination": "mysql_skip_locked", "source": "src/services/agentx-v2-runtime/src/trace_delivery.rs", "index": "idx_v206_trace_outbox_claim", "batchSize": 100, "externalIoAfterCommit": true, "recovery": "trace_outbox replay after Redis loss" },
    { "role": "runtime.worker_attempt", "authority": "runtime_mysql.node_attempts", "coordination": "redis_consumer_group_mysql_lease", "source": "src/services/agentx-v2-runtime/src/engine.rs", "index": "idx_v206_node_attempt_claim", "batchSize": 1, "externalIoAfterCommit": true, "recovery": "attempt row + result hash + Redis redelivery" },
    { "role": "runtime.sandbox_reaper", "authority": "runtime_mysql.sandbox_leases", "coordination": "mysql_skip_locked", "source": "src/services/agentx-v2-runtime/src/sandbox.rs", "index": "idx_v206_sandbox_claim", "batchSize": 1, "externalIoAfterCommit": true, "recovery": "provider label + stable operation key" },
    { "role": "observability.trace_consumer", "authority": "redis.agentx:v2:trace:v1", "coordination": "redis_consumer_group", "source": "src/services/observability/src/main.rs", "index": "clickhouse.event_id_content_hash", "batchSize": 100, "externalIoAfterCommit": true, "recovery": "Redis pending reclaim + ClickHouse hash dedupe" }
  ]
}
